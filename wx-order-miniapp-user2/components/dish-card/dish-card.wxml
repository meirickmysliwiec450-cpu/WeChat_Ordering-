<view class="dish card" bindtap="onDetail">
  <image class="dish-img" src="{{dish.image || dish.imageUrl}}" mode="aspectFill" lazy-load binderror="onImgError" />
  <view class="dish-info">
    <text class="dish-name">{{dish.dishName || dish.name}}</text>
    <text class="dish-desc" wx:if="{{dish.description || dish.desc}}">{{dish.description || dish.desc}}</text>
    <view class="dish-bottom">
      <view class="dish-left">
        <text class="price">¥{{dish.price}}</text>
        <text class="sales">月售{{dish.sales || 0}}</text>
      </view>
      <view class="add-btn" catchtap="onAdd">＋</view>
    </view>
  </view>
</view>
