.dish {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.dish-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
  overflow: hidden;
}

.dish-real-img {
  width: 100%;
  height: 100%;
  border-radius: 22rpx;
}

.dish-info {
  flex: 1;
  min-width: 0;
}

.dish-name {
  font-size: 31rpx;
  font-weight: 700;
}

.dish-desc {
  display: block;
  margin: 12rpx 0 16rpx;
  color: #777777;
  font-size: 24rpx;
  line-height: 1.45;
}

.dish-bottom {
  margin-top: 8rpx;
}

.add-btn {
  width: 104rpx;
  height: 56rpx;
  line-height: 56rpx;
  background: #c01818;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 0;
  margin: 0;
}
