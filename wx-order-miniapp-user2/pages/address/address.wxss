.page { background: #f5f5f5; min-height: 100vh; padding: 20rpx 24rpx 120rpx; }

/* 地址卡片 */
.addr-card { position: relative; background: #fff; border-radius: 18rpx; padding: 28rpx; margin-bottom: 18rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03); }
.addr-card.is-default { background: linear-gradient(135deg, #fffbfb, #fff5f5); border: 2rpx solid rgba(192,24,24,0.15); }

.def-badge {
  position: absolute; top: 0; right: 28rpx;
  font-size: 20rpx; color: #fff; background: #c01818;
  padding: 6rpx 16rpx; border-radius: 0 0 10rpx 10rpx;
}

.addr-body { margin-bottom: 16rpx; }
.addr-row1 { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }
.addr-receiver { font-size: 32rpx; font-weight: 700; color: #222; }
.addr-phone { font-size: 26rpx; color: #999; }
.addr-detail { font-size: 26rpx; color: #666; line-height: 1.5; }

.addr-foot { display: flex; gap: 36rpx; padding-top: 18rpx; border-top: 1rpx solid #f5f5f5; }
.addr-act { font-size: 25rpx; color: #c01818; }
.addr-act.del { color: #ccc; }

/* 空态 */
.empty { text-align: center; padding: 160rpx 0 60rpx; }
.empty-icon { font-size: 90rpx; display: block; }
.empty-title { font-size: 30rpx; font-weight: 700; color: #666; display: block; margin-top: 20rpx; }
.empty-sub { font-size: 24rpx; color: #bbb; display: block; margin-top: 8rpx; }

/* 底部按钮 */
.bottom-btn { position: fixed; bottom: 0; left: 0; right: 0; padding: 16rpx 24rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); background: #f5f5f5; }
.add-btn 
{ width: 100%; 
  height: 88rpx; 
  line-height: 68rpx; 
  font-size: 30rpx; 
  font-weight: 700; 
  color: #fff; 
  background: linear-gradient(135deg, #c01818, #e04030); 
  border-radius: 44rpx; 
  border: none; 
  box-shadow: 0 4rpx 18rpx rgba(192,24,24,0.25); 
}

/* 弹窗 */
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 100; }
.popup { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; border-radius: 28rpx 28rpx 0 0; z-index: 101; animation: up 0.25s; }
@keyframes up { from { transform: translateY(100%); } to { transform: translateY(0); } }
.popup-bar { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 28rpx 16rpx; }
.popup-cancel { font-size: 28rpx; color: #999; }
.popup-title { font-size: 32rpx; font-weight: 800; }
.popup-save { font-size: 28rpx; color: #c01818; font-weight: 700; }
.popup-body { padding: 0 28rpx 30rpx; }
.field { margin-bottom: 24rpx; }
.f-label { font-size: 26rpx; font-weight: 600; color: #555; display: block; margin-bottom: 10rpx; }
.f-input { height: 84rpx; background: #f8f8f8; border-radius: 14rpx; padding: 0 18rpx; font-size: 28rpx; }
.f-textarea { width: 100%; min-height: 150rpx; background: #f8f8f8; border-radius: 14rpx; padding: 18rpx; font-size: 28rpx; box-sizing: border-box; }
