<view class="page">
  <view class="addr-card {{item.isDefault ? 'is-default' : ''}}" wx:for="{{list}}" wx:key="id">
    <view wx:if="{{item.isDefault}}" class="def-badge">默认</view>
    <view class="addr-body">
      <view class="addr-row1">
        <text class="addr-receiver">{{item.receiver}}</text>
        <text class="addr-phone">{{item.phone}}</text>
      </view>
      <text class="addr-detail">📍 {{item.addressDetail}}</text>
    </view>
    <view class="addr-foot">
      <text class="addr-act" wx:if="{{!item.isDefault}}" bindtap="setDefault" data-id="{{item.id}}">设为默认</text>
      <text class="addr-act" bindtap="editAddr" data-item="{{item}}">编辑</text>
      <text class="addr-act del" bindtap="delAddr" data-id="{{item.id}}">删除</text>
    </view>
  </view>

  <view class="empty" wx:if="{{list.length === 0 && !loading}}">
    <text class="empty-icon">📍</text>
    <text class="empty-title">暂无收货地址</text>
    <text class="empty-sub">添加常用地址，下单更快捷</text>
  </view>

  <view class="bottom-btn">
    <button class="add-btn" bindtap="showForm">＋ 添加新地址</button>
  </view>

  <!-- 编辑弹窗 -->
  <view class="mask" wx:if="{{showEdit}}" bindtap="hideForm"></view>
  <view class="popup" wx:if="{{showEdit}}">
    <view class="popup-bar">
      <text class="popup-cancel" bindtap="hideForm">取消</text>
      <text class="popup-title">{{editId ? '编辑地址' : '新增地址'}}</text>
      <text class="popup-save" bindtap="saveAddr">保存</text>
    </view>
    <view class="popup-body">
      <view class="field">
        <text class="f-label">联系人</text>
        <input class="f-input" value="{{form.receiver}}" placeholder="姓名" bindinput="onField" data-key="receiver" />
      </view>
      <view class="field">
        <text class="f-label">手机号</text>
        <input class="f-input" type="number" value="{{form.phone}}" placeholder="手机号码" bindinput="onField" data-key="phone" maxlength="11" />
      </view>
      <view class="field">
        <text class="f-label">详细地址</text>
        <textarea class="f-textarea" value="{{form.addressDetail}}" placeholder="省/市/区/街道/门牌号" bindinput="onField" data-key="addressDetail" />
      </view>
    </view>
  </view>
</view>
