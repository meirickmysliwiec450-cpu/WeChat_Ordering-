<view class="page">
  <!-- 顶部 -->
  <view class="top-bar">
    <view class="top-search" bindtap="goSearch">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜索菜品</text>
    </view>
    <view class="mode-badge">{{diningTypeText}}</view>
  </view>

  <!-- 主区域：左分类 + 右菜品 -->
  <view class="main-area">
    <!-- 左侧分类 -->
    <scroll-view class="cate-bar" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="cate-item {{activeCategory === item.id ? 'cate-on' : ''}}"
            wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="selectCategory">
        <view class="cate-dot" wx:if="{{activeCategory === item.id}}"></view>
        <text>{{item.categoryName || item.name}}</text>
      </view>
      <view style="height:200rpx"></view>
    </scroll-view>

    <!-- 右侧菜品 -->
    <scroll-view class="dish-area" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollTo}}">
      <view class="cate-title" id="cate-{{activeCategory}}">{{activeCateName}}</view>
      <view class="dish-card" wx:for="{{currentDishes}}" wx:key="id" bindtap="viewDishDetail" data-id="{{item.id}}">
        <image class="dish-img" src="{{item.image}}" mode="aspectFill" lazy-load />
        <view class="dish-right">
          <text class="dish-name">{{item.dishName}}</text>
          <view class="dish-meta">
            <text class="dish-sales" wx:if="{{item.sales}}">月售{{item.sales}}</text>
            <text class="dish-stock" wx:if="{{item.stock > 0}}">库存{{item.stock}}</text>
          </view>
          <view class="dish-bottom">
            <view class="dish-prices">
              <text class="dish-price">¥{{item.price}}</text>
              <text class="dish-original" wx:if="{{item.discount}}">¥{{item.discount}}</text>
            </view>
            <view class="add-btn" wx:if="{{item.stock > 0}}" catchtap="addCart" data-id="{{item.id}}" data-item="{{item}}">＋</view>
            <text class="sold-out" wx:else>售罄</text>
          </view>
        </view>
      </view>
      <view class="end-tip">— 已展示全部菜品 —</view>
      <view style="height:200rpx"></view>
    </scroll-view>
  </view>

  <!-- 底部浮动购物车栏 -->
  <view class="cart-bar" wx:if="{{cart.length > 0}}">
    <view class="cart-left" bindtap="toggleCart">
      <view class="cart-icon-wrap">
        <text class="cart-icon">🛒</text>
        <text class="cart-badge">{{summary.totalCount}}</text>
      </view>
      <view class="cart-info">
        <text class="cart-total">¥{{summary.totalPrice}}</text>
        <text class="cart-extra">预估配送费 ¥0</text>
      </view>
    </view>
    <button class="checkout-btn" bindtap="goCheckout">去结算</button>
  </view>

  <!-- 空购物车 -->
  <view class="cart-bar empty-bar" wx:else>
    <view class="cart-icon-wrap empty-icon">
      <text class="cart-icon">🛒</text>
    </view>
    <text class="empty-text">购物车空空如也～</text>
  </view>

  <!-- 购物车弹窗 -->
  <view class="cart-mask" wx:if="{{showCart}}" bindtap="toggleCart"></view>
  <view class="cart-popup" wx:if="{{showCart}}">
    <view class="cart-pop-head">
      <text>购物车</text>
      <text class="clear-btn" bindtap="clearCart">清空</text>
    </view>
    <scroll-view class="cart-pop-list" scroll-y>
      <view class="cart-pop-item" wx:for="{{cart}}" wx:key="id">
        <image class="cart-pop-img" src="{{item.image}}" mode="aspectFill" />
        <text class="cart-pop-name">{{item.name}}</text>
        <view class="cart-pop-right">
          <text class="cart-pop-price">¥{{item.price * item.count}}</text>
          <view class="stepper">
            <text class="step-btn" bindtap="changeCount" data-id="{{item.id}}" data-count="{{item.count - 1}}">−</text>
            <text class="step-num">{{item.count}}</text>
            <text class="step-btn" bindtap="changeCount" data-id="{{item.id}}" data-count="{{item.count + 1}}">＋</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
