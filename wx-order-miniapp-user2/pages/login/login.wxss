.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 80rpx 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #c01818 0%, #e26a2c 48%, #f7f4ef 48%, #f7f4ef 100%);
}

.login-card {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 34rpx;
  padding: 58rpx 42rpx;
  text-align: center;
  box-shadow: 0 18rpx 46rpx rgba(105, 40, 20, 0.16);
}

.logo {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 30rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #c01818, #ee8a36);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 58rpx;
  font-weight: 800;
}

.title {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  color: #222222;
}

.desc {
  display: block;
  margin: 24rpx 0 46rpx;
  color: #777777;
  font-size: 27rpx;
  line-height: 1.7;
}

.login-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: #c01818;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.tip {
  display: block;
  margin-top: 28rpx;
  color: #999999;
  font-size: 23rpx;
}
