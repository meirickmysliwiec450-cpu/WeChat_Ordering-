<view class="login-page">
  <view class="login-card">
    <view class="logo">点</view>
    <text class="title">微信点餐系统</text>
    <text class="desc">登录后可查看菜单、加入购物车、下单支付、查看订单并提交菜品反馈。</text>

    <button class="login-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="handleLogin">
      {{loading ? '登录中...' : '微信一键登录'}}
    </button>

  </view>
</view>
