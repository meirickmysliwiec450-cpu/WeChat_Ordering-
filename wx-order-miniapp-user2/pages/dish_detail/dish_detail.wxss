.detail-page {
  min-height: 100vh;
  background: #f7f4ef;
  padding-bottom: 140rpx;
}

.detail-img-wrap {
  width: 100%;
  height: 500rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-img {
  width: 100%;
  height: 500rpx;
}

.detail-img-text {
  color: #ffffff;
  font-size: 64rpx;
  font-weight: 800;
}

.detail-info {
  margin: -40rpx 24rpx 0;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 1;
}

.detail-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-name {
  font-size: 38rpx;
  font-weight: 800;
  color: #333333;
}

.detail-tag {
  background: #fff0e8;
  color: #c01818;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.detail-desc {
  display: block;
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

.detail-meta {
  display: flex;
  gap: 32rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f3f3;
}

.detail-price-row {
  margin-top: 24rpx;
}

.detail-price {
  font-size: 48rpx;
  font-weight: 800;
  color: #c01818;
}

.detail-price-unit {
  font-size: 26rpx;
  color: #999999;
  margin-left: 4rpx;
}

.detail-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  padding-bottom: env(safe-area-inset-bottom);
}

.detail-footer-price {
  flex: 1;
}

.add-cart-btn {
  width: 260rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: #c01818;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  padding: 0;
  margin: 0;
}

.detail-loading,
.detail-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  color: #999999;
  font-size: 30rpx;
}

.btn-primary {
  background: #c01818;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx;
}
