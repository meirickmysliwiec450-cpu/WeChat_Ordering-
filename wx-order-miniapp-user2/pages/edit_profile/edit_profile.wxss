.page { background: #f5f5f5; min-height: 100vh; }

.avatar-section {
  background: linear-gradient(160deg, #c01818, #e04030);
  padding: 50rpx 0 40rpx; text-align: center;
}
.avatar-picker-btn {
  background: none; border: none; padding: 0; margin: 0; line-height: normal;
}
.avatar-picker-btn::after { border: none; }
.avatar-big {
  width: 140rpx; height: 140rpx; border-radius: 50%;
  background: rgba(255,255,255,0.2);
  margin: 0 auto 16rpx;
  overflow: hidden;
}
.avatar-text-big {
  line-height: 140rpx; font-size: 56rpx; font-weight: 800; color: #fff; text-align: center;
}
.avatar-hint { font-size: 24rpx; color: rgba(255,255,255,0.7); display: block; }

.form-card { background: #fff; border-radius: 20rpx; margin: 24rpx; }
.form-row { display: flex; align-items: center; padding: 26rpx 24rpx; }
.form-row:not(:last-child) { border-bottom: 1rpx solid #f5f5f5; }
.form-label { width: 120rpx; font-size: 28rpx; color: #333; }
.form-input { flex: 1; font-size: 28rpx; text-align: right; color: #333; }

.save-btn {
  width: calc(100% - 48rpx); margin: 30rpx 24rpx;
  height: 88rpx; line-height: 88rpx; font-size: 30rpx; font-weight: 700;
  color: #fff; background: linear-gradient(135deg, #c01818, #e04030);
  border-radius: 44rpx; border: none;
}
