<view class="page">
  <view class="head">
    <text class="head-title">💰 支付记录</text>
    <text class="head-sub" wx:if="{{totalCount}}">共 {{totalCount}} 笔</text>
  </view>

  <block wx:for="{{groupedList}}" wx:key="date">
    <view class="date-header">
      <text class="date-text">{{item.date}}</text>
      <text class="date-total">¥{{item.dayTotal}}</text>
    </view>
    <view class="card" wx:for="{{item.records}}" wx:key="id" wx:for-item="rec">
      <view class="card-top">
        <text class="pay-method">{{rec.payMethod || '微信支付'}}</text>
        <text class="pay-amount">¥{{rec.payAmount}}</text>
      </view>
      <view class="card-bot">{{rec.payTime}}</view>
    </view>
  </block>

  <view class="empty" wx:if="{{totalCount === 0 && !loading}}">
    <text class="empty-icon">💰</text>
    <text class="empty-text">暂无支付记录</text>
  </view>
</view>
