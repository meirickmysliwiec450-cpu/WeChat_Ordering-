.page { background: #f5f5f5; min-height: 100vh; padding: 20rpx 24rpx; }

.head { padding: 16rpx 0 20rpx; }
.head-title { font-size: 36rpx; font-weight: 800; display: block; }
.head-sub { font-size: 24rpx; color: #999; display: block; margin-top: 4rpx; }

.date-header { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 0 12rpx; }
.date-text { font-size: 28rpx; font-weight: 700; color: #333; }
.date-total { font-size: 26rpx; color: #e04030; font-weight: 600; }

.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 14rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03); }
.card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.pay-no { font-size: 25rpx; color: #999; }
.pay-amount { font-size: 36rpx; font-weight: 800; color: #e04030; }
.card-mid { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.pay-method { font-size: 28rpx; font-weight: 600; color: #333; }
.pay-time { font-size: 24rpx; color: #aaa; }
.card-bot { font-size: 23rpx; color: #ccc; }

.empty { text-align: center; padding: 160rpx 0; }
.empty-icon { font-size: 80rpx; display: block; }
.empty-text { font-size: 28rpx; color: #999; display: block; margin-top: 16rpx; }
