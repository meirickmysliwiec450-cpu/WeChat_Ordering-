<view class="page">
  <view wx:if="{{loading}}" class="empty">订单详情加载中...</view>
  <view wx:elif="{{!order}}" class="empty">订单不存在</view>

  <block wx:else>
    <view class="card header-card">
      <view class="between">
        <text class="title">订单详情</text>
        <text class="status">{{order.statusText}}</text>
      </view>
      <text class="muted">订单号 {{order.orderNo}}</text>
      <text class="muted time">{{order.createTime}}</text>
      <view class="tag-line">
        <text class="tag">{{order.diningTypeText || '堂食'}}</text>
      </view>
    </view>

    <view class="section-title">商品明细</view>
    <view class="card">
      <view class="dish-line between" wx:for="{{order.items}}" wx:key="id">
        <view>
          <text class="dish-name">{{item.name}}</text>
          <text class="muted">￥{{item.price}} × {{item.count}}</text>
        </view>
        <text class="price">￥{{item.price * item.count}}</text>
      </view>
      <view class="summary between">
        <text>共 {{order.totalCount}} 件</text>
        <text class="total-price">￥{{order.totalPrice}}</text>
      </view>
    </view>

    <view class="section-title">订单信息</view>
    <view class="card info-card">
      <view class="info-row" wx:if="{{order.tableInfo}}">
        <text class="label">堂食信息</text>
        <text>{{order.tableInfo}}</text>
      </view>
      <view class="info-row" wx:if="{{order.address}}">
        <text class="label">外送地址</text>
        <text>{{order.address}}</text>
      </view>
      <view class="info-row" wx:if="{{order.remark}}">
        <text class="label">备注</text>
        <text>{{order.remark}}</text>
      </view>
    </view>

    <!-- 已完成已评价：显示评价内容 -->
    <view class="card comment-card" wx:if="{{order.status === 'completed' && hasReviewed}}">
      <view class="between">
        <text class="label">我的评价</text>
        <text class="muted">{{reviewTime}}</text>
      </view>
      <view class="review-stars" wx:if="{{reviewScore > 0}}">
        <text wx:for="{{reviewStars}}" wx:key="*this">⭐</text>
      </view>
      <text class="comment-content" wx:if="{{reviewContent}}">{{reviewContent}}</text>
      <text class="comment-content muted" wx:else>未填写文字评价</text>
    </view>

    <!-- 待支付订单 -->
    <block wx:if="{{order.status === 'pending'}}">
      <button class="btn-primary review-btn" bindtap="payOrder">💰 去支付</button>
      <button class="btn-plain review-btn" bindtap="cancelOrder">取消订单</button>
    </block>
    <!-- 已支付订单 -->
    <block wx:if="{{order.status === 'paid'}}">
      <button class="btn-primary review-btn" bindtap="finishOrder">✅ 确认收餐</button>
    </block>
    <!-- 已完成订单的操作按钮 -->
    <block wx:if="{{order.status === 'completed'}}">
      <button wx:if="{{!hasReviewed}}" class="btn-primary review-btn" bindtap="goReview">⭐ 订单评价</button>
      <button wx:if="{{hasReviewed}}" class="review-btn review-update-btn" bindtap="goReview">✏️ 追加评价</button>
    </block>
  </block>
</view>
