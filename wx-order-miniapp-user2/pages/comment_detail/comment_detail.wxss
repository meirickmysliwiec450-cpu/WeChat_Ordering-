.loading,
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  color: #999999;
  font-size: 30rpx;
}

.header-card {
  margin-bottom: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 800;
}

.order-id {
  display: block;
  margin-top: 10rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #555555;
  margin-bottom: 14rpx;
}

.photo {
  width: 100%;
  height: 400rpx;
  border-radius: 22rpx;
  display: block;
}

.content {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: #333333;
}

.back-btn {
  width: 100%;
  margin-top: 28rpx;
}

.btn-primary {
  background: #c01818;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx;
}
