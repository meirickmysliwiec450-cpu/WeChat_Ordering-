<view class="page">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{!comment}}" class="empty">
    <text>暂无反馈记录</text>
    <button class="btn-primary" style="margin-top: 30rpx;" bindtap="goBack">返回</button>
  </view>

  <block wx:else>
    <view class="card header-card">
      <view class="between">
        <text class="title">订单反馈</text>
        <text class="muted">{{comment.createTime}}</text>
      </view>
      <text class="muted order-id">订单号 {{comment.orderId}}</text>
    </view>

    <view class="card">
      <text class="label">反馈照片</text>
      <image wx:if="{{comment.photoUrl}}" class="photo" src="{{comment.photoUrl}}" mode="aspectFill" binderror="onPhotoError"></image>
      <text wx:else class="muted" style="display: block; margin-top: 16rpx;">未上传照片</text>
    </view>

    <view class="card">
      <text class="label">评价内容</text>
      <text class="content">{{comment.content}}</text>
    </view>

    <button class="btn-primary back-btn" bindtap="goBack">返回</button>
  </block>
</view>
