.page { background: #f5f5f5; min-height: 100vh; padding: 20rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.title { font-size: 34rpx; font-weight: 800; display: block; }
.sub { font-size: 24rpx; color: #999; display: block; margin-top: 8rpx; }
.label { font-size: 28rpx; font-weight: 600; color: #333; display: block; margin-bottom: 16rpx; }

.score-card { text-align: center; }
.stars { display: flex; justify-content: center; gap: 16rpx; }
.star { font-size: 52rpx; }
.star-on { transform: scale(1.15); }
.score-hint { font-size: 26rpx; color: #e26a2c; margin-top: 12rpx; display: block; }

.textarea { width: 100%; min-height: 200rpx; background: #f8f8f8; border-radius: 12rpx; padding: 18rpx; font-size: 27rpx; box-sizing: border-box; }
.counter { text-align: right; font-size: 22rpx; color: #ccc; margin-top: 8rpx; }

.submit-btn { width: 100%; margin-top: 20rpx; }
