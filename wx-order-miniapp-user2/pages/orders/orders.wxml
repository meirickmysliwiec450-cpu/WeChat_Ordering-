<view class="page">
  <scroll-view class="tabs" scroll-x>
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="changeTab"
    >
      {{item.name}}
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="empty">订单加载中...</view>
  <view wx:elif="{{orders.length === 0}}" class="empty">暂无订单记录</view>

  <view class="order card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
    <view class="between">
      <text class="order-id">订单号 {{item.id}}</text>
      <text class="status">{{item.statusText}}</text>
    </view>
    <view class="meta-row">
      <text class="tag">{{item.diningTypeText || '堂食'}}</text>
      <text class="muted time">{{item.createTime}}</text>
    </view>
    <view class="order-items">
      <view wx:for="{{item.items}}" wx:key="id" wx:for-item="dish" class="between dish-line">
        <text>{{dish.name}} × {{dish.count}}</text>
        <text>￥{{dish.price * dish.count}}</text>
      </view>
    </view>
    <view class="remark" wx:if="{{item.tableInfo}}">堂食信息：{{item.tableInfo}}</view>
    <view class="remark" wx:if="{{item.address}}">外送地址：{{item.address}}</view>
    <view class="remark" wx:if="{{item.remark}}">备注：{{item.remark}}</view>
    <view class="feedback-done" wx:if="{{item.feedback}}">
      <text>已反馈：{{item.feedback.content}}</text>
    </view>
    <view class="between total">
      <text class="muted">共 {{item.totalCount}} 件</text>
      <text class="price">￥{{item.totalPrice}}</text>
    </view>
    <view class="actions">
      <button wx:if="{{item.status === 'pending'}}" class="btn-outline small-btn" data-id="{{item.id}}" catchtap="payOrder">继续支付</button>
      <button wx:if="{{item.status === 'pending' || item.status === 'paid'}}" class="btn-plain small-btn" data-id="{{item.id}}" catchtap="cancelOrder">取消订单</button>
      <button wx:if="{{item.status === 'paid'}}" class="btn-primary small-btn" data-id="{{item.id}}" catchtap="finishOrder">确认收餐</button>
      <button wx:if="{{item.status === 'completed'}}" class="btn-outline small-btn" data-id="{{item.id}}" catchtap="goFeedback">照片反馈</button>
      <button wx:if="{{item.status === 'completed' || item.status === 'cancelled'}}" class="btn-plain small-btn" data-id="{{item.id}}" catchtap="deleteOrder">删除</button>
    </view>
  </view>
</view>
