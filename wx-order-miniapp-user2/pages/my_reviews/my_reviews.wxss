.page { background: #f5f5f5; min-height: 100vh; padding: 20rpx; }

.header-card { background: linear-gradient(135deg, #ff9800, #f57c00); border-radius: 20rpx; padding: 30rpx 28rpx; margin-bottom: 24rpx; color: #fff; }
.header-title { font-size: 36rpx; font-weight: 800; display: block; }
.header-sub { font-size: 24rpx; opacity: 0.85; display: block; margin-top: 8rpx; }

.review-item { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.review-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14rpx; }
.review-score { display: flex; gap: 4rpx; }
.star { font-size: 32rpx; }
.star-off { font-size: 32rpx; color: #ddd; }
.review-time { font-size: 23rpx; color: #bbb; }
.review-content { font-size: 28rpx; color: #333; line-height: 1.7; }
.review-no-content { font-size: 26rpx; color: #ccc; font-style: italic; }
.review-order { font-size: 22rpx; color: #bbb; margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid #f5f5f5; }

.empty { text-align: center; padding: 100rpx 0; }
.empty-icon { font-size: 80rpx; display: block; }
.empty-text { font-size: 28rpx; color: #999; display: block; margin-top: 16rpx; }
.empty-sub { font-size: 24rpx; color: #ccc; display: block; margin-top: 8rpx; }
