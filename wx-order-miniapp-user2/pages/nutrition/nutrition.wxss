.page { display: flex; flex-direction: column; height: 100vh; background: #f5f3ef; }

/* ========== 毛玻璃头部 ========== */
.glass-header { position: relative; margin: 16rpx 20rpx 0; border-radius: 24rpx; overflow: hidden; }
.glass-bg {
  position: absolute; inset: 0;
  background: linear-gradient(135deg, rgba(192,24,24,0.92) 0%, rgba(226,106,44,0.85) 100%);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}
.glass-content { position: relative; display: flex; align-items: center; padding: 28rpx 28rpx 24rpx; }
.glass-icon { font-size: 52rpx; margin-right: 18rpx; filter: drop-shadow(0 2rpx 4rpx rgba(0,0,0,0.2)); }
.glass-title { display: block; font-size: 34rpx; font-weight: 800; color: #fff; }
.glass-sub { display: block; font-size: 22rpx; color: rgba(255,255,255,0.85); margin-top: 4rpx; }

/* ========== Tab ========== */
.nav-tabs { display: flex; margin: 20rpx 20rpx 0; background: #fff; border-radius: 20rpx; padding: 8rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.nav-tab { flex: 1; text-align: center; padding: 18rpx 0; border-radius: 14rpx; font-size: 27rpx; color: #999; transition: all 0.25s; }
.nav-tab .nav-icon { margin-right: 6rpx; }
.nav-active { background: linear-gradient(135deg, #c01818, #e26a2c); color: #fff; font-weight: 700; box-shadow: 0 4rpx 14rpx rgba(192,24,24,0.3); }

/* ========== 内容区 ========== */
.tab-body { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
.scroll-area { flex: 1; height: 0; }

.sec-title { display: flex; align-items: center; padding: 24rpx 20rpx 12rpx; font-size: 28rpx; font-weight: 700; color: #333; }
.sec-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #e26a2c; margin-right: 10rpx; }

/* 推荐横滑卡片 */
.rec-row { white-space: nowrap; padding: 0 12rpx 8rpx; }
.dish-card {
  display: inline-block; width: 420rpx; margin: 0 8rpx; background: #fff;
  border-radius: 20rpx; overflow: hidden; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  vertical-align: top; transition: transform 0.2s;
}
.dish-card:active { transform: scale(0.97); }
.dish-img-wrap { position: relative; }
.dish-img { width: 100%; height: 210rpx; }
.dish-tag {
  position: absolute; top: 14rpx; left: 14rpx;
  font-size: 20rpx; color: #fff; background: rgba(0,0,0,0.45);
  padding: 4rpx 14rpx; border-radius: 16rpx;
}
.dish-info { padding: 16rpx 18rpx 18rpx; white-space: normal; }
.dish-name { font-size: 28rpx; font-weight: 700; color: #222; display: block; }
.dish-reason { font-size: 22rpx; color: #999; display: block; margin-top: 6rpx; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.dish-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 14rpx; }
.dish-price { font-size: 30rpx; font-weight: 800; color: #e26a2c; }

.pill-btn {
  background: linear-gradient(135deg, #c01818, #e04030); color: #fff;
  font-size: 22rpx; padding: 8rpx 22rpx; border-radius: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(192,24,24,0.25); transition: all 0.15s;
}
.pill-btn:active { transform: scale(0.94); opacity: 0.9; }

/* 搜索结果 */
.result-item { display: flex; margin: 10rpx 16rpx; background: #fff; border-radius: 18rpx; overflow: hidden; box-shadow: 0 2rpx 14rpx rgba(0,0,0,0.04); }
.result-item:active { opacity: 0.9; }
.result-img { width: 180rpx; height: 180rpx; flex-shrink: 0; }
.result-body { flex: 1; padding: 18rpx; display: flex; flex-direction: column; }
.result-top { display: flex; align-items: center; gap: 10rpx; }
.result-name { font-size: 28rpx; font-weight: 700; }
.result-tag { font-size: 20rpx; color: #c01818; background: #fff2ec; padding: 2rpx 12rpx; border-radius: 10rpx; }
.result-reason { font-size: 23rpx; color: #888; margin-top: 6rpx; line-height: 1.5; flex: 1; }
.result-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 10rpx; }
.result-price { font-size: 30rpx; font-weight: 800; color: #e26a2c; }

/* 偏好输入 */
.pref-bar { background: #fff; border-top: 1rpx solid #f0f0f0; }
.chip-row { padding: 12rpx 0 4rpx; }
.chip-scroll { white-space: nowrap; padding: 0 16rpx; }
.chip {
  display: inline-block; font-size: 23rpx; color: #c01818; background: #fff2ec;
  padding: 10rpx 22rpx; border-radius: 28rpx; margin-right: 12rpx;
  border: 1rpx solid rgba(192,24,24,0.15);
}
.chip:active { background: #c01818; color: #fff; }
.input-row { display: flex; align-items: center; padding: 12rpx 16rpx 12rpx; padding-bottom: calc(12rpx + env(safe-area-inset-bottom)); }
.pref-input { flex: 1; height: 68rpx; background: #f8f8f8; border-radius: 34rpx; padding: 0 22rpx; font-size: 26rpx; }
.voice-btn { font-size: 36rpx; margin-left: 14rpx; width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f0f0f0; }
.voice-btn.muted { opacity: 0.5; }

/* ========== 营养助手 ========== */
.report-bar { padding: 12rpx 16rpx; }
.report-btn { display: flex; align-items: center; justify-content: center; gap: 10rpx; width: 100%; height: 76rpx; font-size: 26rpx; color: #2e7d32; background: #e8f5e9; border: 2rpx solid #c8e6c9; border-radius: 16rpx; }
.report-icon { font-size: 30rpx; }
.report-card { margin: 0 14rpx 14rpx; padding: 22rpx; background: #fff; border-radius: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03); }
.rp-title { font-size: 28rpx; font-weight: 700; display: block; margin-bottom: 12rpx; }
.rp-body { font-size: 26rpx; color: #555; line-height: 1.85; white-space: pre-wrap; }

.msg-list { flex: 1; padding: 8rpx 14rpx; }
.msg-empty { display: flex; flex-direction: column; align-items: center; padding-top: 60rpx; }
.empty-icon { font-size: 72rpx; margin-bottom: 12rpx; }
.empty-title { font-size: 28rpx; color: #666; }
.empty-chips { margin-top: 24rpx; text-align: center; }
.empty-chips .chip { margin-bottom: 12rpx; }

.msg-row { display: flex; align-items: flex-start; margin-bottom: 20rpx; }
.msg-avatar { font-size: 34rpx; flex-shrink: 0; margin: 0 8rpx; }
.msg-left { flex-direction: row; }
.msg-right { flex-direction: row-reverse; }
.msg-bubble { max-width: 70%; padding: 16rpx 22rpx; border-radius: 20rpx; }
.bubble-ai { background: #fff; border-top-left-radius: 6rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.bubble-user { background: linear-gradient(135deg, #c01818, #e04030); border-top-right-radius: 6rpx; }
.bubble-user text { color: #fff; font-size: 27rpx; line-height: 1.6; }
.bubble-ai text { color: #333; font-size: 27rpx; line-height: 1.6; }

.input-bar { display: flex; align-items: center; padding: 12rpx 14rpx; padding-bottom: calc(12rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #f0f0f0; }
.msg-input { flex: 1; height: 68rpx; background: #f8f8f8; border-radius: 34rpx; padding: 0 22rpx; font-size: 26rpx; }
.pill-send { margin-left: 12rpx; height: 68rpx; line-height: 68rpx; padding: 0 30rpx; font-size: 26rpx; font-weight: 600; color: #fff; background: linear-gradient(135deg, #c01818, #e04030); border-radius: 34rpx; border: none; box-shadow: 0 2rpx 10rpx rgba(192,24,24,0.25); }
.pill-send[disabled] { background: #e0e0e0; box-shadow: none; color: #aaa; }
