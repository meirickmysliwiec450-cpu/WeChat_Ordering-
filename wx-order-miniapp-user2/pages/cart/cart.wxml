<view class="page cart-page">
  <view wx:if="{{cart.length === 0}}" class="empty">
    <view>购物车暂无菜品</view>
    <button class="btn-primary empty-btn" bindtap="goMenu">去点餐</button>
  </view>

  <block wx:else>
    <view class="cart-list">
      <view class="cart-item card" wx:for="{{cart}}" wx:key="id">
        <view class="cart-img" style="background: {{item.imageColor}};"></view>
        <view class="cart-info">
          <view class="between">
            <text class="cart-name">{{item.name}}</text>
            <text class="price">￥{{item.price}}</text>
          </view>
          <view class="between cart-actions">
            <text class="muted">小计 ￥{{item.price * item.count}}</text>
            <view class="stepper">
              <button data-id="{{item.id}}" data-count="{{item.count - 1}}" bindtap="changeCount">-</button>
              <text>{{item.count}}</text>
              <button data-id="{{item.id}}" data-count="{{item.count + 1}}" bindtap="changeCount">+</button>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="checkout card">
      <view class="field">
        <text class="label">收货/取餐信息</text>
        <input class="input" value="{{address}}" placeholder="请输入桌号、窗口或配送地址" bindinput="onAddress" />
      </view>
      <view class="field">
        <text class="label">订单备注</text>
        <input class="input" value="{{remark}}" placeholder="如少辣、不要葱、打包等" bindinput="onRemark" />
      </view>
      <view class="between total-row">
        <text>共 {{summary.totalCount}} 件</text>
        <text class="total-price">合计 ￥{{summary.totalPrice}}</text>
      </view>
      <button class="btn-primary submit-btn" bindtap="submitOrder">提交并支付</button>
    </view>
  </block>
</view>
