.page { background: #f5f5f5; padding-bottom: 20rpx; }

/* ========== 顶部轮播 ========== */
.top-section { margin: 0 20rpx; padding-top: 20rpx; }
.top-badge { font-size: 26rpx; color: #888; margin-bottom: 12rpx; padding-left: 6rpx; }
.swiper { width: 100%; height: 360rpx; border-radius: 20rpx; overflow: hidden; box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.12); }
.swiper-slide { width: 100%; height: 100%; position: relative; }
.swiper-img { width: 100%; height: 100%; }
.swiper-info {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 30rpx 28rpx 20rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.7));
  display: flex; justify-content: space-between; align-items: flex-end;
}
.swiper-name { color: #fff; font-size: 34rpx; font-weight: 700; }
.swiper-price { color: #ffd54f; font-size: 32rpx; font-weight: 800; }

/* ========== 用餐方式 ========== */
.card { background: #fff; border-radius: 18rpx; margin: 20rpx; padding: 24rpx; }
.dining-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.dining-title { font-size: 30rpx; font-weight: 700; }
.dining-current { font-size: 24rpx; color: #c01818; background: #fff2ec; padding: 6rpx 16rpx; border-radius: 20rpx; }
.dining-options { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12rpx; }
.dining-opt { border: 2rpx solid #eee; border-radius: 16rpx; padding: 22rpx 14rpx; text-align: center; background: #fafafa; transition: all 0.2s; }
.dining-opt.active { border-color: #c01818; background: #fff2ec; }
.opt-icon { font-size: 40rpx; display: block; }
.opt-name { font-size: 26rpx; font-weight: 700; color: #333; display: block; margin-top: 6rpx; }
.opt-desc { font-size: 20rpx; color: #999; display: block; margin-top: 2rpx; }
.start-btn 
{ 
  width: 100%; 
  margin-top: 20rpx; 
  height: 80rpx; 
  line-height: 50rpx; 
  font-size: 30rpx; 
  font-weight: 700; 
  color: #fff; 
  background: linear-gradient(135deg, #c01818, #e04030); 
  border-radius: 40rpx; 
  border: none; 
}
.start-btn[disabled] { background: #ddd; color: #999; }
/* ========== 推荐 ========== */
.scroll-area { flex: 1; height: calc(100vh - 800rpx);}
.sec-title { display: flex; align-items: center; padding: 24rpx 20rpx 12rpx; font-size: 28rpx; font-weight: 700; color: #333; }
.sec-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #e26a2c; margin-right: 10rpx; }

/* 推荐横滑卡片 */
.rec-row { white-space: nowrap; padding: 0 12rpx 8rpx; }
.dish-card {
  display: inline-block; width: 420rpx; margin: 0 8rpx; background: #fff;
  border-radius: 20rpx; overflow: hidden; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  vertical-align: top; transition: transform 0.2s;
}
.dish-card:active { transform: scale(0.97); }
.dish-img-wrap { position: relative; }
.dish-img { width: 100%; height: 210rpx; }
.dish-tag {
  position: absolute; top: 14rpx; left: 14rpx;
  font-size: 20rpx; color: #fff; background: rgba(0,0,0,0.45);
  padding: 4rpx 14rpx; border-radius: 16rpx;
}
.dish-info { padding: 16rpx 18rpx 18rpx; white-space: normal; }
.dish-name { font-size: 28rpx; font-weight: 700; color: #222; display: block; }
.dish-reason { font-size: 22rpx; color: #999; display: block; margin-top: 6rpx; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.dish-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 14rpx; }
.dish-price { font-size: 30rpx; font-weight: 800; color: #e26a2c; }

.pill-btn {
  background: linear-gradient(135deg, #c01818, #e04030); color: #fff;
  font-size: 22rpx; padding: 8rpx 22rpx; border-radius: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(192,24,24,0.25); transition: all 0.15s;
}
.pill-btn:active { transform: scale(0.94); opacity: 0.9; }
/* ========== 热销 ========== */
.section-title { font-size: 30rpx; font-weight: 700; padding: 30rpx 24rpx 10rpx; color: #333; }
