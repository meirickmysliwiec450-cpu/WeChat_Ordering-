.checkout-page {
  padding-bottom: 60rpx;
}

.mode-card,
.info-card {
  margin-bottom: 24rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.switch-btn {
  width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  margin: 0;
  padding: 0;
  background: #fff0e8;
  color: #c01818;
  font-size: 24rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #555555;
  margin-bottom: 14rpx;
}

.address-btn {
  width: 100%;
  margin-top: 16rpx;
}

.dish-line {
  min-height: 92rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.dish-line:last-child {
  border-bottom: 0;
}

.dish-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.summary {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #f0f0f0;
}

.total-price {
  color: #c01818;
  font-size: 38rpx;
  font-weight: 800;
}

.submit-btn {
  width: 100%;
  margin-top: 28rpx;
}
