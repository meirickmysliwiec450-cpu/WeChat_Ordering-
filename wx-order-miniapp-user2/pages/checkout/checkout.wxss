.checkout-page {
  padding-bottom: 60rpx;
}

.mode-card,
.info-card {
  margin-bottom: 24rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.mode-picker { display: flex; gap: 14rpx; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #f5f5f5; }
.mode-opt { flex: 1; text-align: center; padding: 16rpx 0; font-size: 26rpx; color: #666; background: #f8f8f8; border-radius: 14rpx; border: 2rpx solid transparent; }
.mode-on { color: #c01818; background: #fff2ec; border-color: #c01818; font-weight: 700; }

.switch-btn {
  width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  margin: 0;
  padding: 0;
  background: #fff0e8;
  color: #c01818;
  font-size: 24rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #555555;
  margin-bottom: 14rpx;
}

.address-btn {
  width: 100%;
  margin-top: 16rpx;
}

.dish-line {
  min-height: 92rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.dish-line:last-child {
  border-bottom: 0;
}

.dish-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.summary {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #f0f0f0;
}

.total-price {
  color: #c01818;
  font-size: 38rpx;
  font-weight: 800;
}

.submit-btn {
  width: 100%;
  margin-top: 28rpx;
}

/* 地址选择 */
.addr-list { margin-bottom: 10rpx; }
.addr-opt { background: #fafafa; border-radius: 16rpx; padding: 22rpx; margin-bottom: 10rpx; border: 2rpx solid transparent; transition: all 0.2s; }
.addr-opt:active { opacity: 0.8; }
.addr-opt-on { border-color: #c01818; background: #fffbfb; box-shadow: 0 2rpx 10rpx rgba(192,24,24,0.08); }
.addr-opt-top { display: flex; align-items: center; gap: 14rpx; margin-bottom: 10rpx; }
.addr-opt-name { font-size: 28rpx; font-weight: 700; color: #222; }
.addr-opt-phone { font-size: 25rpx; color: #999; }
.addr-opt-tag { font-size: 20rpx; color: #fff; background: #c01818; padding: 2rpx 12rpx; border-radius: 8rpx; }
.addr-opt-detail { font-size: 24rpx; color: #888; line-height: 1.5; display: block; }
.required { color: #e04030; }
.addr-empty { padding: 30rpx 0; text-align: center; }
