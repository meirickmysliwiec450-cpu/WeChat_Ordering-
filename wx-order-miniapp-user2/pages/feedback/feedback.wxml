<view class="page">
  <view class="card intro">
    <text class="intro-title">功能反馈</text>
    <text class="intro-desc">针对系统功能提交反馈，可上传照片并填写描述，便于管理员收集并整改</text>
  </view>
  <view class="card form">

    <view class="field">
      <text class="label">问题描述</text>
      <textarea class="textarea" value="{{content}}" placeholder="请描述问题" bindinput="onContent" />
    </view>

    <button class="btn-primary submit-btn" bindtap="submitFeedback">提交反馈</button>
  </view>

  <view class="section-title" wx:if="{{feedbacks.length}}">历史反馈</view>
  <view class="card feedback-item" wx:for="{{feedbacks}}" wx:key="id">
    <view class="between">
      <text class="muted">{{item.createTime}}</text>
    </view>
    <text class="content">{{item.content}}</text>
  </view>
</view>
