.page { background: #f5f5f5; min-height: 100vh; padding: 20rpx; }

.intro { margin-bottom: 20rpx; }
.intro-title { font-size: 34rpx; font-weight: 800; display: block; }
.intro-desc { margin-top: 10rpx; color: #888; font-size: 25rpx; line-height: 1.6; display: block; }

.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.field { margin-bottom: 18rpx; }
.label { display: block; font-size: 26rpx; color: #555; margin-bottom: 12rpx; font-weight: 600; }
.textarea { width: 100%; min-height: 160rpx; background: #f8f8f8; border-radius: 12rpx; padding: 18rpx; font-size: 27rpx; box-sizing: border-box; }
.submit-btn { width: 100%; }

.section-title { font-size: 28rpx; font-weight: 700; color: #333; padding: 10rpx 0 16rpx; }

/* 对话式反馈列表 */
.feedback-item { margin-bottom: 8rpx; }
.fb-row { display: flex; padding: 12rpx 0; }
.fb-user { justify-content: flex-end; }
.fb-merchant { justify-content: flex-start; }
.fb-bubble { max-width: 85%; padding: 18rpx 22rpx; border-radius: 18rpx; }
.fb-bubble-user { background: #e3f2fd; border-bottom-right-radius: 6rpx; }
.fb-bubble-reply { background: #fff; border: 1rpx solid #e8e8e8; border-bottom-left-radius: 6rpx; }
.fb-bubble-waiting { background: #fffbf0; border: 1rpx solid #ffe0b2; }
.fb-label { font-size: 24rpx; color: #c01818; font-weight: 600; display: block; margin-bottom: 6rpx; }
.fb-content { font-size: 27rpx; color: #333; line-height: 1.6; display: block; }
.fb-time { font-size: 22rpx; color: #aaa; display: block; margin-top: 8rpx; text-align: right; }
.fb-divider { height: 1rpx; background: #f0f0f0; margin-top: 8rpx; }

.empty { text-align: center; padding: 80rpx 0; }
.empty-text { font-size: 28rpx; color: #999; }
