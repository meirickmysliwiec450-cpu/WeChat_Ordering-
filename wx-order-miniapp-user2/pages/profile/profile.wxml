<view class="page">
  <!-- 头像区 -->
  <view class="head-card" bindtap="goEditProfile">
    <image class="avatar-circle" wx:if="{{profile.avatar}}" src="{{profile.avatar}}" mode="aspectFill" />
    <view class="avatar-circle avatar-text" wx:else>{{profile.avatarText || '微'}}</view>
    <text class="head-name">{{profile.nickName || '微信用户'}}</text>
    <text class="head-arrow">查看个人信息 ›</text>
  </view>

  <!-- 数据概览 -->
  <view class="stats-row">
    <view class="stat-item" bindtap="goOrders">
      <text class="stat-num">{{orderCount}}</text>
      <text class="stat-label">我的订单</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{points}}</text>
      <text class="stat-label">积分 (¥1=1分)</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-card">
    <view class="menu-row" bindtap="goAddress">
      <text class="menu-icon">📍</text>
      <text class="menu-text">收货地址</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goPayments">
      <text class="menu-icon">💰</text>
      <text class="menu-text">支付记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goOrders">
      <text class="menu-icon">📦</text>
      <text class="menu-text">我的订单</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goReviews">
      <text class="menu-icon">⭐</text>
      <text class="menu-text">我的评价</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goFeedback">
      <text class="menu-icon">💬</text>
      <text class="menu-text">意见反馈</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row">
      <text class="menu-icon">📞</text>
      <text class="menu-text">客服电话</text>
      <text class="menu-val">{{servicePhone}}</text>
    </view>
  </view>

  <view class="logout-btn" bindtap="logout">退出登录</view>
</view>
