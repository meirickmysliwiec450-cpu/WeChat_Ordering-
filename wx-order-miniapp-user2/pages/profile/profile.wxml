<view class="page">
  <view class="profile-head card">
    <view class="avatar">{{profile.avatarText}}</view>
    <view>
      <text class="nickname">{{profile.nickname}}</text>
      <text class="muted">完善个人信息后下单更快捷</text>
    </view>
  </view>

  <view class="section-title">修改个人信息</view>
  <view class="card form">
    <view class="field">
      <text class="label">昵称</text>
      <input class="input" value="{{profile.nickname}}" placeholder="请输入昵称" data-key="nickname" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" value="{{profile.phone}}" placeholder="请输入手机号" data-key="phone" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">默认取餐/配送信息</text>
      <input class="input" value="{{profile.address}}" placeholder="如 3 号桌、宿舍楼、公司地址" data-key="address" bindinput="onInput" />
    </view>
    <button class="btn-primary save-btn" bindtap="saveProfile">保存信息</button>
  </view>

  <view class="section-title">常用功能</view>
  <view class="card menu-list">
    <view class="menu-item" bindtap="goOrders">
      <text>我的订单</text>
      <text class="muted">查看订单状态</text>
    </view>
    <view class="menu-item" bindtap="goFeedback">
      <text>菜品反馈</text>
      <text class="muted">向管理员反馈商品信息</text>
    </view>
    <view class="menu-item">
      <text>客服电话</text>
      <text class="muted">{{servicePhone}}</text>
    </view>
    <view class="menu-item logout" bindtap="logout">
      <text>退出登录</text>
      <text class="muted">清除当前登录态</text>
    </view>
  </view>
</view>
