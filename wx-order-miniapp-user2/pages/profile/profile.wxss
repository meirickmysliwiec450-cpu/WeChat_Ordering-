.page { background: #f5f5f5; min-height: 100vh; padding-bottom: 40rpx; }

/* 头像区 */
.head-card {
  margin: 24rpx 24rpx 0; padding: 40rpx 0 32rpx;
  background: linear-gradient(160deg, #c01818 0%, #e04030 60%, #f08060 100%);
  border-radius: 24rpx; text-align: center; color: #fff;
}
.avatar-circle {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: rgba(255,255,255,0.2);
  margin: 0 auto 16rpx;
  overflow: hidden;
}
.avatar-text {
  line-height: 100rpx; font-size: 42rpx; font-weight: 800; text-align: center;
}
.head-name { font-size: 36rpx; font-weight: 800; display: block; }
.head-arrow { font-size: 24rpx; opacity: 0.8; display: block; margin-top: 8rpx; }

/* 个人信息 */
.sec-title { font-size: 26rpx; font-weight: 700; color: #999; padding: 28rpx 28rpx 12rpx; }
.info-card { background: #fff; border-radius: 20rpx; margin: 0 24rpx; padding: 8rpx 0; }
.info-row { display: flex; align-items: center; padding: 22rpx 24rpx; }
.info-row:not(:last-child) { border-bottom: 1rpx solid #f5f5f5; }
.info-label { width: 140rpx; font-size: 28rpx; color: #333; font-weight: 500; flex-shrink: 0; }
.info-input { flex: 1; font-size: 28rpx; text-align: right; color: #333; }
.save-btn { width: calc(100% - 48rpx); margin: 20rpx 24rpx 16rpx; height: 80rpx; line-height: 80rpx; font-size: 28rpx; font-weight: 600; color: #fff; background: linear-gradient(135deg, #c01818, #e04030); border-radius: 40rpx; border: none; }

/* 数据概览 */
.stats-row {
  display: flex; align-items: center;
  margin: -24rpx 24rpx 20rpx;
  background: #fff; border-radius: 20rpx; padding: 28rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}
.stat-item { flex: 1; text-align: center; }
.stat-divider { width: 2rpx; height: 48rpx; background: #f0f0f0; }
.stat-num { font-size: 40rpx; font-weight: 800; color: #222; display: block; }
.stat-label { font-size: 23rpx; color: #999; display: block; margin-top: 6rpx; }

/* 菜单 */
.menu-card { background: #fff; border-radius: 20rpx; margin: 0 24rpx; }
.menu-row { display: flex; align-items: center; padding: 26rpx 24rpx; }
.menu-row:not(:last-child) { border-bottom: 1rpx solid #f5f5f5; }
.menu-icon { font-size: 34rpx; width: 52rpx; }
.menu-text { flex: 1; font-size: 28rpx; color: #333; }
.menu-arrow { font-size: 36rpx; color: #ccc; }
.menu-val { font-size: 26rpx; color: #999; }

/* 退出 */
.logout-btn { margin: 40rpx 24rpx; height: 88rpx; line-height: 88rpx; text-align: center; font-size: 28rpx; color: #999; background: #fff; border-radius: 44rpx; }
