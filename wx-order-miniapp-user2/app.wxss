page {
  background: #f7f4ef;
  color: #2f2f2f;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(105, 40, 20, 0.08);
  padding: 24rpx;
  box-sizing: border-box;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: #888888;
  font-size: 24rpx;
}

.price {
  color: #c01818;
  font-weight: 700;
}

.btn-primary,
.btn-outline,
.btn-plain {
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 76rpx;
  height: 76rpx;
  padding: 0 32rpx;
  margin: 0;
}

.btn-primary {
  background: #c01818;
  color: #ffffff;
}

.btn-outline {
  background: #fff7f3;
  color: #c01818;
  border: 1rpx solid #f0b3a0;
}

.btn-plain {
  background: #f2f2f2;
  color: #555555;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  margin: 34rpx 0 20rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #fff0e8;
  color: #c01818;
  font-size: 22rpx;
}

.empty {
  text-align: center;
  color: #999999;
  padding: 120rpx 30rpx;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  background: #f8f8f8;
  border-radius: 18rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
}

.input {
  height: 86rpx;
}

.textarea {
  min-height: 180rpx;
  padding-top: 18rpx;
}
